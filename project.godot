; Engine configuration file.
; Godot 4.7 — DUSTLINE Godot Port

config_version=5

[application]

config/name="DUSTLINE — Godot Port"
config/description="CS 风格战术射击游戏 DUSTLINE 的 Godot 4.7 完整移植 + 增强（真实弹道/战术AI/多模式/击杀反馈）"
